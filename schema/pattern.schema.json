{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nullthrone/slop-check/schema/pattern.schema.json",
  "title": "slop-check pattern",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "modality",
    "name",
    "summary",
    "category",
    "status",
    "realizations",
    "fix",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "modality": {
      "enum": [
        "text",
        "image",
        "web",
        "code",
        "audio",
        "video"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "category": {
      "enum": [
        "rhetoric",
        "lexical",
        "structure",
        "rhythm",
        "typography",
        "formatting",
        "attribution",
        "composition",
        "tone",
        "visual-style",
        "visual-composition",
        "visual-artifact",
        "visual-subject",
        "visual-typography",
        "web-layout",
        "web-visual-style",
        "web-component",
        "web-content",
        "web-markup"
      ]
    },
    "status": {
      "enum": [
        "observation",
        "candidate",
        "core"
      ]
    },
    "detector": {
      "$ref": "#/$defs/detector"
    },
    "threshold": {
      "$ref": "#/$defs/threshold"
    },
    "requires": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "min_other_findings": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "realizations": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^([a-z]{2,3}|\\*)$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/realization"
      }
    },
    "legitimate_use": {
      "type": "string"
    },
    "fix": {
      "type": "string",
      "minLength": 10
    },
    "prevention": {
      "type": "string",
      "minLength": 10
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "locator": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "relation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "relation": {
            "enum": [
              "overlaps",
              "distinct-from",
              "supersedes",
              "split-from",
              "merged-into"
            ]
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "candidate",
              "core"
            ]
          }
        }
      },
      "then": {
        "required": [
          "detector",
          "threshold",
          "prevention"
        ]
      }
    }
  ],
  "$defs": {
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "regex",
            "lexicon",
            "metric",
            "llm",
            "vision"
          ]
        },
        "position": {
          "enum": [
            "any",
            "text_start",
            "paragraph_start",
            "paragraph_end",
            "last_paragraph",
            "sentence_start"
          ],
          "default": "any"
        },
        "metric": {
          "enum": [
            "em_dash_density",
            "curly_quotes",
            "sentence_length_cv",
            "emoji_decoration",
            "markdown_emphasis_density",
            "paragraph_start_ratio",
            "nominalization_density",
            "bullet_bold_lead",
            "triad",
            "comma_density",
            "hyphenated_premodifier_density"
          ]
        },
        "params": {
          "type": "object"
        },
        "rubric": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "metric"
              }
            }
          },
          "then": {
            "required": [
              "metric"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "llm",
                  "vision"
                ]
              }
            }
          },
          "then": {
            "required": [
              "rubric"
            ]
          }
        }
      ]
    },
    "count_rule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_count": {
          "type": "number",
          "minimum": 0
        },
        "per_words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "comparison": {
          "enum": [
            "gte",
            "gt"
          ]
        },
        "scope": {
          "enum": [
            "text",
            "paragraph"
          ]
        },
        "value": {
          "$ref": "#/$defs/value_rule"
        },
        "min_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "min_words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "value_rule": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "op",
        "x"
      ],
      "properties": {
        "op": {
          "enum": [
            "lt",
            "lte",
            "gt",
            "gte"
          ]
        },
        "x": {
          "type": "number"
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_count": {
          "type": "number",
          "minimum": 0,
          "default": 1
        },
        "per_words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "comparison": {
          "enum": [
            "gte",
            "gt"
          ],
          "default": "gte"
        },
        "scope": {
          "enum": [
            "text",
            "paragraph"
          ],
          "default": "text"
        },
        "short_text": {
          "$ref": "#/$defs/count_rule"
        },
        "value": {
          "$ref": "#/$defs/value_rule"
        },
        "min_units": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "min_words": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "context_overrides": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "default",
              "informal",
              "technical",
              "academic",
              "marketing"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/count_rule"
          }
        }
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "terms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "positive": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "negative": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "test_texts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "expect"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "expect": {
                "enum": [
                  "trigger",
                  "no_trigger"
                ]
              },
              "context": {
                "enum": [
                  "default",
                  "informal",
                  "technical",
                  "academic",
                  "marketing"
                ]
              }
            }
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
